{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@game-scheduler/e-football/landing/feature": [
        "./libs/e-football/landing/feature/src/index.ts"
      ],
      "@game-scheduler/e-football/landing/ui": [
        "./libs/e-football/landing/ui/src/index.ts"
      ],
      "@game-scheduler/e-football/landing/data-access": [
        "./libs/e-football/landing/data-access/src/index.ts"
      ],
      "@game-scheduler/e-football/match-center/feature": [
        "./libs/e-football/match-center/feature/src/index.ts"
      ],
      "@game-scheduler/e-football/match-center/ui": [
        "./libs/e-football/match-center/ui/src/index.ts"
      ],
      "@game-scheduler/e-football/match-center/data-access": [
        "./libs/e-football/match-center/data-access/src/index.ts"
      ],
      "@game-scheduler/e-football/shared/ui": [
        "./libs/e-football/shared/ui/src/index.ts"
      ],
      "@game-scheduler/e-football/shared/data-access": [
        "./libs/e-football/shared/data-access/src/index.ts"
      ],
      "@game-scheduler/data-access": [
        "./libs/e-football/shared/data-access/src/index.ts"
      ],
      "@game-scheduler/supabase": ["./libs/e-football/supabase/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
